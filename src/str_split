#!/bin/bash

usage() {
    echo "split string by size with separator"
    echo "usage: $0 -s <string> -n <size> [-se <separator>]"
    exit 1
}

# Valeur par défaut
SEP=" "

# Arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -s)
            STRING="$2"
            shift 2
            ;;
        -n)
            SIZE="$2"
            shift 2
            ;;
        -se)
            SEP="$2"
            shift 2
            ;;
        *)
            usage
            ;;
    esac
done

# Vérifications
if [[ -z "$STRING" || -z "$SIZE" ]]; then
    usage
fi

# Traitement
echo "$STRING" | fold -w"$SIZE" | paste -sd"$SEP"
